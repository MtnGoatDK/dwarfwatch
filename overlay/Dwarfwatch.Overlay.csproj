<Project Sdk="Microsoft.NET.Sdk">

  <!-- A borderless, always-on-top window that shows the Dwarfwatch page in overlay mode (WebView2),
       built the same way as MRAkdown's Windows host. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Dwarfwatch</AssemblyName>
    <RootNamespace>Dwarfwatch.Overlay</RootNamespace>
    <SelfContained>false</SelfContained>
    <!-- made by make_icon.py -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
